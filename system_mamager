#!/bin/sh
set -eu
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
SCRIPT="$DIR/system_mamager.py"

if [ "$(id -u)" -ne 0 ]; then
    if ! command -v sudo >/dev/null 2>&1; then
        echo "SYSTEM MAMAGER 需要 root 权限，但系统未安装 sudo。" >&2
        exit 1
    fi
    if [ -n "${SUDO_ASKPASS:-}" ]; then
        exec sudo -A -- python3 -B "$SCRIPT" "$@"
    fi
    exec sudo -- python3 -B "$SCRIPT" "$@"
fi

exec python3 -B "$SCRIPT" "$@"
